{
    "name": "alaca/wp-performance",
    "description": "WP Performance Optimizer - cache & performance plugin for WordPress",
    "type": "wordpress-plugin",
    "keywords": [
        "wordpress",
        "cache",
        "performance",
        "speed optimization"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ante Laca",
            "email": "ante.laca@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "WPP\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "lint": "find src inc tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null"
    }
}
